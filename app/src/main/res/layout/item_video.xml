<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="82dp"
    android:orientation="vertical" android:gravity="center_vertical"
    android:paddingHorizontal="18dp" android:background="@drawable/rounded_card"
    android:layout_marginBottom="10dp">
    <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/white" android:textSize="15sp" android:maxLines="1"/>
    <TextView android:id="@+id/path" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/muted" android:textSize="12sp" android:maxLines="1"/>
</LinearLayout>
