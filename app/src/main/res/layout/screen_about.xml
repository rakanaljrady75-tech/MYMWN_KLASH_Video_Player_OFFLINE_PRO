<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="حول المطور" android:textColor="@color/white"
            android:textSize="28sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="كلاش • KLASH" android:textColor="@color/purple"
            android:textSize="24sp" android:textStyle="bold" android:layout_marginTop="18dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="تم تطوير MYMWN KLASH بفكرة تجمع تشغيل الفيديوهات المحلية مع تجربة مشاهدة عمودية سريعة ومريحة. هذا المشروع يحمل هوية وحقوق المطور كلاش، ويمكن تطويره وتخصيصه لاحقاً حسب الحاجة."
            android:textColor="@color/muted" android:textSize="16sp"
            android:lineSpacingExtra="7dp" android:layout_marginTop="12dp"/>

        <TextView android:id="@+id/contactTelegram"
            android:layout_width="match_parent" android:layout_height="62dp"
            android:gravity="center" android:text="✈  مراسلة المطور على Telegram"
            android:textColor="@color/white" android:textStyle="bold"
            android:textSize="16sp" android:background="@drawable/rounded_card"
            android:layout_marginTop="28dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@YM_IBB" android:textColor="@color/purple"
            android:textSize="15sp" android:layout_gravity="center"
            android:layout_marginTop="10dp"/>
    </LinearLayout>
</ScrollView>
